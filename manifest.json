{
  "manifest_version": 3,
  "name": "Voice Corrector for Autodarts",
  "version": "0.1.6",
  "description": "Correct misdetected darts on Autodarts with voice commands. Not affiliated with Autodarts.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Voice Corrector for Autodarts settings",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://play.autodarts.com/*", "https://play.autodarts.io/*"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://play.autodarts.com/*", "https://play.autodarts.io/*"],
      "js": ["src/segments.js", "src/parser.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
